{
  "name": "Observability Tutorial",
  "image": "mcr.microsoft.com/devcontainers/java:17",
  // No devcontainer features: each one forces an image build when the Codespace is
  // created. Go comes from install-go.sh instead (seconds, not minutes).
  "onCreateCommand": "bash .devcontainer/install-go.sh",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/usr/local/go/bin"
  },
  // No forwardPorts: a port forwarded before a lesson runs shows a 502 page.
  // Codespaces forwards 8080 by itself once the order service starts listening.
  "portsAttributes": {
    "8080": { "label": "Food delivery app", "onAutoForward": "notify" },
    "8081": { "label": "kitchen-service", "onAutoForward": "ignore" },
    "8082": { "label": "delivery-service", "onAutoForward": "ignore" }
  },
  // Builds every lesson once. A Codespaces prebuild runs this ahead of time.
  "updateContentCommand": "bash scripts/build.sh",
  "postCreateCommand": "java -version && /usr/local/go/bin/go version",
  "customizations": {
    "vscode": {
      // The Java image adds the Java extension pack by default. Its language server
      // needs more memory and CPU than the whole app, so leave it out.
      "extensions": ["-vscjava.vscode-java-pack"]
    }
  }
}
